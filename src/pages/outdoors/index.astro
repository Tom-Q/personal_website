---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const adventures = (await getCollection('adventures')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<PageLayout
	title="Outdoors — Thomas R. Colin"
	description="Mountains, expeditions, and wild places. Climbing, mountaineering, hiking, cycling, packrafting, and sailing."
	bodyClass="theme-outdoors"
>
	<div class="page-header">
		<h1>Outdoors</h1>
		<p class="lead">Mountains, rivers, oceans, and wild places.</p>
	</div>

	<section class="section">
		<h2 class="section-heading">Adventures</h2>
		<div class="card-grid">
			{adventures.map((adventure) => (
				<a href={`/outdoors/adventures/${adventure.id}`} class="adventure-card">
					<div class="card-img">
						<Image src={adventure.data.heroImage} alt="" width={400} height={260} />
					</div>
					<div class="card-info">
						<div class="card-meta">
							{adventure.data.location} &middot; {adventure.data.date.getFullYear()}
						</div>
						<h3>{adventure.data.title}</h3>
						<p>{adventure.data.summary}</p>
					</div>
				</a>
			))}
			<a href="/outdoors/cv" class="cv-card">
				<div class="cv-card-inner">
					<div class="cv-icon">⛰</div>
					<h3>Outdoors CV</h3>
					<p>Route log, certifications, and technical training. Useful if you're looking for an alpine partner.</p>
				</div>
			</a>
		</div>
	</section>

	<hr />

	<section class="section">
		<h2 class="section-heading">Galleries</h2>
		<p class="coming-soon">Coming soon — shorter trips and photo collections.</p>
	</section>
</PageLayout>

<style>
	.page-header {
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2.5em;
		padding-bottom: 1em;
	}
	.page-header h1 {
		font-size: 2.2em;
		margin: 0 0 0.4em;
	}
	.lead {
		color: rgb(var(--gray));
		font-size: 1em;
		margin: 0;
	}
	.section {
		margin-bottom: 2.5em;
	}
	.section-heading {
		font-size: 0.85em;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgb(var(--gray));
		margin-bottom: 1.25em;
	}
	hr {
		margin: 0 0 2.5em;
	}

	/* Shared card grid */
	.card-grid {
		display: flex;
		flex-direction: column;
		gap: 1.25em;
	}

	/* Adventure cards */
	.adventure-card {
		display: grid;
		grid-template-columns: 240px 1fr;
		text-decoration: none;
		color: inherit;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		overflow: hidden;
		background: white;
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.adventure-card:hover {
		border-color: var(--accent);
		box-shadow: var(--box-shadow);
	}
	.card-img img {
		width: 100%;
		height: 180px;
		object-fit: cover;
		display: block;
	}
	.card-info {
		padding: 1.25em 1.5em;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.card-meta {
		font-size: 0.78em;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: rgb(var(--gray));
		margin-bottom: 0.4em;
	}
	.card-info h3 {
		font-size: 1.15em;
		margin: 0 0 0.4em;
	}
	.card-info p {
		color: rgb(var(--gray));
		font-size: 0.88em;
		margin: 0;
		line-height: 1.6;
	}

	/* Outdoors CV card */
	.cv-card {
		display: block;
		text-decoration: none;
		color: inherit;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		background: white;
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.cv-card:hover {
		border-color: var(--accent);
		box-shadow: var(--box-shadow);
	}
	.cv-card-inner {
		padding: 1.5em;
		display: flex;
		flex-direction: column;
		gap: 0.4em;
	}
	.cv-icon {
		font-size: 1.5em;
		line-height: 1;
		margin-bottom: 0.2em;
	}
	.cv-card h3 {
		font-size: 1.15em;
		margin: 0;
	}
	.cv-card p {
		color: rgb(var(--gray));
		font-size: 0.88em;
		margin: 0;
		line-height: 1.6;
		max-width: 520px;
	}

	.coming-soon {
		color: rgb(var(--gray));
		font-size: 0.9em;
		font-style: italic;
		margin: 0;
	}

	@media (max-width: 640px) {
		.adventure-card {
			grid-template-columns: 1fr;
		}
		.card-img img {
			height: 200px;
		}
		.card-info {
			padding: 1.25em;
		}
	}
</style>
