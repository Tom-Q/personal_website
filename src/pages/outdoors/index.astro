---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const adventures = (await getCollection('adventures')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const galleries = (await getCollection('galleries')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<PageLayout
	title="Outdoors — Thomas R. Colin"
	description="Mountains, expeditions, and wild places. Climbing, mountaineering, hiking, cycling, packrafting, and sailing."
	bodyClass="theme-outdoors"
>
	<div class="page-header">
		<h1>Outdoors</h1>
	</div>

	<section class="section">
		<h2 class="section-heading">Adventures</h2>
		<p class="section-intro">In my view, a trip is an adventure not because it is extreme, but because it is a jump into the unknown. About half the trips below ended in retreat: I came across difficulties beyond my abilities, or dangers I was not willing to chance, so I turned around.</p>
		<div class="card-grid">
			{adventures.map((adventure) => (
				<a href={`/outdoors/adventures/${adventure.id}`} class="adventure-card">
					<div class="card-img">
						<Image src={adventure.data.heroImage} alt="" width={400} height={260} />
					</div>
					<div class="card-info">
						<div class="card-meta">
							{adventure.data.location} &middot; {adventure.data.date.getFullYear()}
						</div>
						<h3>{adventure.data.title}</h3>
						<p>{adventure.data.summary}</p>
					</div>
				</a>
			))}
			<a href="/outdoors/cv" class="cv-card">
				<div class="cv-card-inner">
					<div class="cv-icon">⛰</div>
					<h3>Outdoors CV</h3>
					<p>Route log, certifications, and technical training.</p>
				</div>
			</a>
		</div>
	</section>

	<hr />

	<section class="section">
		<h2 class="section-heading">Galleries</h2>
		<p class="section-intro" style="margin-bottom: 1.25em;">Photos from other trips.</p>
		<div class="gallery-grid">
			{galleries.map((g) => (
				<a href={`/outdoors/galleries/${g.id}`} class="gallery-card">
					<Image src={g.data.heroImage} alt="" width={600} height={400} />
					<div class="gallery-overlay">
						<h3>{g.data.title}</h3>
						<p>{g.data.location}</p>
					</div>
				</a>
			))}
		</div>
	</section>
</PageLayout>

<style>
	.page-header {
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2.5em;
		padding-bottom: 1em;
	}
	.page-header h1 {
		font-size: 2.2em;
		margin: 0 0 0.4em;
	}
	.lead {
		color: rgb(var(--gray));
		font-size: 1em;
		margin: 0;
	}
	.section {
		margin-bottom: 2.5em;
	}
	.section-heading {
		font-size: 0.85em;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgb(var(--gray));
		margin-bottom: 1.25em;
	}
	hr {
		margin: 0 0 2.5em;
	}

	.section-intro {
		color: rgb(var(--gray));
		font-size: 0.92em;
		line-height: 1.7;
		margin: 0 0 1.5em;
		text-align: justify;
	}

	/* Shared card grid */
	.card-grid {
		display: flex;
		flex-direction: column;
		gap: 1.25em;
	}

	/* Adventure cards */
	.adventure-card {
		display: grid;
		grid-template-columns: 240px 1fr;
		text-decoration: none;
		color: inherit;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		overflow: hidden;
		background: white;
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.adventure-card:hover {
		border-color: var(--accent);
		box-shadow: var(--box-shadow);
	}
	.card-img img {
		width: 100%;
		height: 180px;
		object-fit: cover;
		display: block;
	}
	.card-info {
		padding: 1.25em 1.5em;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.card-meta {
		font-size: 0.78em;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: rgb(var(--gray));
		margin-bottom: 0.4em;
	}
	.card-info h3 {
		font-size: 1.15em;
		margin: 0 0 0.4em;
	}
	.card-info p {
		color: rgb(var(--gray));
		font-size: 0.88em;
		margin: 0;
		line-height: 1.6;
	}

	/* Outdoors CV card */
	.cv-card {
		display: block;
		text-decoration: none;
		color: inherit;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		background: white;
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.cv-card:hover {
		border-color: var(--accent);
		box-shadow: var(--box-shadow);
	}
	.cv-card-inner {
		padding: 1.5em;
		display: flex;
		flex-direction: column;
		gap: 0.4em;
	}
	.cv-icon {
		font-size: 1.5em;
		line-height: 1;
		margin-bottom: 0.2em;
	}
	.cv-card h3 {
		font-size: 1.15em;
		margin: 0;
	}
	.cv-card p {
		color: rgb(var(--gray));
		font-size: 0.88em;
		margin: 0;
		line-height: 1.6;
		max-width: 520px;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 8px;
	}
	.gallery-card {
		position: relative;
		display: block;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border-radius: 4px;
		text-decoration: none;
		color: white;
		background: #111;
	}
	.gallery-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: opacity 0.2s, transform 0.3s;
	}
	.gallery-card:hover img {
		opacity: 0.85;
		transform: scale(1.03);
	}
	.gallery-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, rgba(0,0,0,0) 40%, rgba(0,0,0,0.6) 100%);
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 1em;
	}
	.gallery-overlay h3 {
		font-size: 1.05em;
		margin: 0 0 0.2em;
		color: white;
	}
	.gallery-overlay p {
		font-size: 0.75em;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		opacity: 0.8;
		margin: 0;
		color: white;
	}

	@media (max-width: 640px) {
		.adventure-card {
			grid-template-columns: 1fr;
		}
		.card-img img {
			height: 200px;
		}
		.card-info {
			padding: 1.25em;
		}
	}
</style>
