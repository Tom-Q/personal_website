---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import heroImg from '../assets/home.JPG';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<div class="landing">
			<Image class="landing-bg" src={heroImg} alt="" />
			<div class="landing-overlay">
				<div class="landing-inner">
					<h1>Thomas R. Colin</h1>
					<p class="under-construction">Site under construction</p>
					<nav class="nav-grid" aria-label="Site sections">
						<a href="/outdoors" class="nav-card">
							<h2>Outdoors</h2>
							<p>Adventures, expeditions, and wild places</p>
						</a>
						<a href="/science-tech" class="nav-card">
							<h2>Science & Tech</h2>
							<p>Research, software, and side projects</p>
						</a>
						<a href="/notes" class="nav-card">
							<h2>Notes</h2>
							<p>Books, ideas, and outdoors philosophy</p>
						</a>
						<a href="/about" class="nav-card">
							<h2>About</h2>
							<p>Bio, contacts, and links</p>
						</a>
					</nav>
				</div>
			</div>
		</div>

		<Footer />
	</body>
</html>

<style>
	.landing {
		position: relative;
		height: calc(100vh - 56px);
		min-height: 480px;
		overflow: hidden;
		background: #111;
	}

	.landing-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		border-radius: 0;
	}

	.landing-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		padding: 3em;
	}

	.landing-inner {
		max-width: 400px;
		width: 100%;
		background: rgba(255, 255, 255, 0.88);
		backdrop-filter: blur(6px);
		border-radius: 12px;
		padding: 2em 2em 2em;
	}

	.landing-inner h1 {
		font-size: 1.8em;
		margin: 0 0 0.25em;
	}
	.under-construction {
		font-size: 0.8em;
		color: rgb(var(--gray));
		margin: 0 0 1em;
		font-style: italic;
	}

	/* Nav cards */
	.nav-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.65em;
	}
	.nav-card {
		display: block;
		padding: 1em 1.25em;
		background: white;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.15s,
			transform 0.15s,
			box-shadow 0.15s;
	}
	.nav-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
		box-shadow: var(--box-shadow);
		color: inherit;
	}
	.nav-card h2 {
		font-size: 0.95em;
		margin-bottom: 0.2em;
		color: var(--accent);
	}
	.nav-card p {
		color: rgb(var(--gray));
		font-size: 0.78em;
		margin: 0;
		line-height: 1.4;
	}

	@media (max-width: 720px) {
		.landing-overlay {
			justify-content: center;
			align-items: flex-end;
			padding: 2em 1.25em;
		}
		.landing-inner {
			max-width: 100%;
		}
	}
</style>
