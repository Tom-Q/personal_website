---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const notes = await getCollection('notes');
---

<PageLayout
	title="Notes — Thomas R. Colin"
	description="Writing on outdoors, books, and ideas."
	bodyClass=""
>
	<div class="page-header">
		<h1>Notes</h1>
		<p class="lead">Outdoors philosophy, book recommendations, and other writing.</p>
	</div>

	<ul class="note-list">
		{notes.map((note) => (
			<li>
				<a href={`/notes/${note.id}`} class="note-card">
					<h2>{note.data.title}</h2>
					<p>{note.data.summary}</p>
				</a>
			</li>
		))}
	</ul>
</PageLayout>

<style>
	.page-header {
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2.5em;
		padding-bottom: 1em;
	}
	.page-header h1 {
		font-size: 2.2em;
		margin: 0 0 0.4em;
	}
	.lead {
		color: rgb(var(--gray));
		font-size: 1em;
		margin: 0;
	}
	.note-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1em;
	}
	.note-card {
		display: block;
		padding: 1.25em 1.5em;
		background: white;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 6px;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.note-card:hover {
		border-color: var(--accent);
		box-shadow: var(--box-shadow);
	}
	.note-card h2 {
		font-size: 1.15em;
		margin: 0 0 0.3em;
	}
	.note-card p {
		color: rgb(var(--gray));
		font-size: 0.9em;
		margin: 0;
	}
</style>
