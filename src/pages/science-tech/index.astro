---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const allProjects = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order
);

const research  = allProjects.filter(p => p.data.category === 'research');
const personal  = allProjects.filter(p => p.data.category === 'personal');

const statusLabel: Record<string, string> = {
	active:   'Active',
	complete: 'Complete',
	'on-hold': 'On hold',
};

---

<PageLayout
	title="Science & Tech — Thomas R. Colin"
	description="Research projects, side projects, and CV."
	bodyClass="theme-projects"
>
	<div class="page-header">
		<h1>Science & Tech</h1>
		<p class="lead">Research, software, and side projects.</p>
	</div>

	<section class="section">
		<h2 class="section-heading">Research</h2>
		<div class="project-grid">
			{research.map((project) => (
				<a href={`/science-tech/projects/${project.id}`} class="project-card">
					<div class="card-top">
						<span class={`status-badge status-${project.data.status}`}>
							{statusLabel[project.data.status]}
						</span>
					</div>
					<h3>{project.data.title}</h3>
					<p>{project.data.summary}</p>
					<div class="tags">
						{project.data.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
				</a>
			))}
		</div>
	</section>

	<section class="section">
		<h2 class="section-heading">Personal projects</h2>
		<div class="project-grid">
			{personal.map((project) => (
				<a href={`/science-tech/projects/${project.id}`} class="project-card">
					<div class="card-top">
						<span class={`status-badge status-${project.data.status}`}>
							{statusLabel[project.data.status]}
						</span>
					</div>
					<h3>{project.data.title}</h3>
					<p>{project.data.summary}</p>
					<div class="tags">
						{project.data.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
				</a>
			))}
		</div>
	</section>

	<hr />

	<section class="section">
		<h2 class="section-heading">CV</h2>
		<a href="/science-tech/cv" class="cv-link-card">
			<div>
				<strong>Thomas R. Colin, PhD</strong>
				<p>Publications, professional background, and downloadable PDF.</p>
			</div>
			<span class="arrow">→</span>
		</a>
	</section>
</PageLayout>

<style>
	.page-header {
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2.5em;
		padding-bottom: 1em;
	}
	.page-header h1 {
		font-size: 2.2em;
		margin: 0 0 0.4em;
	}
	.lead {
		color: rgb(var(--gray));
		font-size: 1em;
		margin: 0;
	}
	.section {
		margin-bottom: 2.5em;
	}
	.section-heading {
		font-size: 0.85em;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgb(var(--gray));
		margin-bottom: 1.25em;
	}
	hr {
		margin: 0 0 2.5em;
	}
	.project-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25em;
	}
	.project-card {
		display: flex;
		flex-direction: column;
		gap: 0.6em;
		padding: 1.5em;
		background: white;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
	}
	.project-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
		box-shadow: var(--box-shadow);
	}
	.card-top {
		display: flex;
		align-items: center;
	}
	.project-card h3 {
		font-size: 1.05em;
		margin: 0;
	}
	.project-card p {
		color: rgb(var(--gray));
		font-size: 0.88em;
		margin: 0;
		line-height: 1.55;
		flex: 1;
	}
	.status-badge {
		font-size: 0.7em;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 0.2em 0.6em;
		border-radius: 3px;
	}
	.status-active   { background: #e6f4ea; color: #2d7a3a; }
	.status-complete { background: #e8edf4; color: #3a5278; }
	.status-on-hold  { background: #f5f0e8; color: #7a6a3a; }
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		margin-top: 0.1em;
	}
	.tag {
		font-size: 0.75em;
		color: rgb(var(--gray));
		background-color: #f0ede8;
		padding: 0.15em 0.5em;
		border-radius: 3px;
	}

	/* CV link card */
	.cv-link-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.25em 1.5em;
		background: white;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.15s, box-shadow 0.15s;
		max-width: 480px;
	}
	.cv-link-card:hover {
		border-color: var(--accent);
		box-shadow: var(--box-shadow);
	}
	.cv-link-card strong {
		display: block;
		font-size: 1em;
		margin-bottom: 0.25em;
	}
	.cv-link-card p {
		color: rgb(var(--gray));
		font-size: 0.88em;
		margin: 0;
		line-height: 1.5;
	}
	.arrow {
		font-size: 1.2em;
		color: rgb(var(--gray));
		flex-shrink: 0;
		margin-left: 1em;
	}

	@media (max-width: 600px) {
		.project-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
