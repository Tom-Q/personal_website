---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="CV — Thomas R. Colin" description="Professional background, experience, and publications of Thomas R. Colin." bodyClass="theme-projects">
	<div class="page-header">
		<div class="cv-title">
			<h1>Thomas R. Colin, PhD</h1>
		</div>
		<a href="/resume.pdf" download class="download-btn" aria-label="Download CV as PDF">Download PDF</a>
	</div>

	<section class="cv-section pdf-section">
		<embed src="/resume.pdf" type="application/pdf" class="cv-pdf" />
	</section>

	<hr />

	<section class="cv-section">
		<h2>Selected Publications</h2>
		<ol class="pub-list">
			<li class="pub-entry">
				<span class="pub-year">2025</span>
				<div class="pub-content">
					<strong>ACC representations of reward-driven motivation over hierarchically-organized behavior</strong><br />
					E Foinikianaki, I Ikink, TR Colin, RJ Alejandro, CB Holroyd ·
					<em>NeuroImage</em>
				</div>
			</li>
			<li class="pub-entry">
				<span class="pub-year">2025</span>
				<div class="pub-content">
					<strong>Distributed representations for cognitive control in frontal medial cortex</strong><br />
					TR Colin, I Ikink, CB Holroyd ·
					<em>Journal of Cognitive Neuroscience</em>
				</div>
			</li>
			<li class="pub-entry">
				<span class="pub-year">2022</span>
				<div class="pub-content">
					<strong>A hierarchy of distributed task representations in the Anterior Cingulate Cortex</strong><br />
					TR Colin, I Ikink, CB Holroyd ·
					<em>Reinforcement Learning and Decision Making (RLDM 2022)</em>
				</div>
			</li>
			<li class="pub-entry">
				<span class="pub-year">2020</span>
				<div class="pub-content">
					<strong>Intentions and creative insights: a reinforcement learning study of creative exploration in problem-solving</strong><br />
					TR Colin ·
					<em>PhD thesis, University of Plymouth</em>
				</div>
			</li>
			<li class="pub-entry">
				<span class="pub-year">2019</span>
				<div class="pub-content">
					<strong>Reinforcement learning and insight in the artificial pigeon</strong><br />
					TR Colin, T Belpaeme ·
					<em>Proceedings of the Annual Meeting of the Cognitive Science Society</em>
				</div>
			</li>
			<li class="pub-entry">
				<span class="pub-year">2016</span>
				<div class="pub-content">
					<strong>Hierarchical reinforcement learning as creative problem solving</strong><br />
					TR Colin, T Belpaeme, A Cangelosi, N Hemion ·
					<em>Robotics and Autonomous Systems</em>
				</div>
			</li>
			<li class="pub-entry">
				<span class="pub-year">2014</span>
				<div class="pub-content">
					<strong>Real time modeling of the cognitive load of an urban search and rescue robot operator</strong><br />
					TR Colin, NJJM Smets, T Mioch, MA Neerincx ·
					<em>IEEE International Symposium on Robot and Human Interactive Communication</em>
				</div>
			</li>
		</ol>
	</section>
</PageLayout>

<style>
	.page-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2.5em;
		padding-bottom: 1.5em;
		flex-wrap: wrap;
	}
	.cv-title h1 {
		font-size: 1.8em;
		margin: 0;
	}
	.download-btn {
		display: inline-block;
		padding: 0.5em 1.2em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 4px;
		font-size: 0.85em;
		text-decoration: none;
		color: rgb(var(--gray));
		white-space: nowrap;
		transition: border-color 0.15s, color 0.15s;
	}
	.download-btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	/* PDF embed */
	.pdf-section {
		margin-bottom: 0;
	}
	.cv-pdf {
		width: 100%;
		height: 900px;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 4px;
	}

	/* Sections */
	.cv-section {
		margin-bottom: 2em;
	}
	.cv-section h2 {
		font-size: 0.85em;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgb(var(--gray));
		margin-bottom: 1.5em;
	}
	hr {
		margin: 2em 0;
	}

	/* Publications */
	.pub-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1.25em;
		counter-reset: pub-counter;
	}
	.pub-entry {
		display: flex;
		gap: 1.5em;
		align-items: baseline;
	}
	.pub-year {
		color: rgb(var(--gray));
		font-size: 0.85em;
		min-width: 42px;
	}
	.pub-content {
		font-size: 0.95em;
		line-height: 1.6;
	}

</style>
