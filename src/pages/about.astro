---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="About — Thomas R. Colin" description="Bio, contacts, and links for Thomas R. Colin." bodyClass="theme-projects">
	<div class="page-header">
		<h1>About</h1>
	</div>

	<section class="bio">
		<p>
			I'm a software and ML engineer with a background spanning a decade of academic research
			and several years of industry software development. My research — conducted during a PhD
			in Cognitive Science at Plymouth University and a postdoc at Ghent University — focused
			on computational modeling of cognition and brain function, using deep learning and
			reinforcement learning. I'm now focused on building software products, with a particular
			interest in applied ML and conversational AI.
		</p>
		<p>
			Outside of work, I spend as much time as possible outdoors — hiking, packrafting, and
			technical alpinism, with the occasional larger expedition. I've traveled self-supported
			to Patagonia, the Arctic, and the Amazon rainforest, and I'm always planning the next one.
		</p>
	</section>

	<hr />

	<section class="contact">
		<h2>Contact & Links</h2>
		<ul class="link-list">
			<li>
				<span class="link-label">Email</span>
				<span id="contact-email">[enable JavaScript to view]</span>
				<script>
					document.getElementById('contact-email').textContent = 'thomas.r.colin' + ' @ ' + 'gmail';
				</script>
			</li>
			<li>
				<span class="link-label">GitHub</span>
				<a href="https://github.com/Tom-Q" target="_blank">github.com/Tom-Q</a>
			</li>
			<li>
				<span class="link-label">LinkedIn</span>
				<a href="https://www.linkedin.com/in/thomas-colin-phd" target="_blank">linkedin.com/in/thomas-colin-phd</a>
			</li>
		</ul>
	</section>
</PageLayout>

<style>
	.page-header {
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2em;
		padding-bottom: 0.5em;
	}
	.page-header h1 {
		font-size: 2em;
		margin: 0;
	}
	.bio {
		margin-bottom: 2.5em;
	}
	hr {
		margin: 2em 0;
	}
	.contact h2 {
		font-size: 1.2em;
		margin-bottom: 1.25em;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: rgb(var(--gray));
	}
	.link-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75em;
	}
	.link-list li {
		display: flex;
		align-items: baseline;
		gap: 1.25em;
	}
	.link-label {
		font-size: 0.85em;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: rgb(var(--gray));
		min-width: 90px;
	}
</style>
