---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Gallery from '../components/Gallery.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	summary: string;
	date?: Date;
	heroImage?: ImageMetadata;
	gallery?: string[];
	captions?: Record<string, string>;
	slug: string;
}

const { title, summary, heroImage, gallery = [], captions = {}, slug } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={`${title} — Thomas R. Colin`} description={summary} />
		<style>
			.hero {
				position: relative;
				height: 60vh;
				min-height: 320px;
				overflow: hidden;
				background: #111;
			}
			.hero-bg {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center 40%;
				border-radius: 0;
				z-index: 0;
			}
			.hero-content {
				position: absolute;
				inset: 0;
				z-index: 1;
				background: linear-gradient(
					to bottom,
					rgba(0, 0, 0, 0.0) 20%,
					rgba(0, 0, 0, 0.65) 100%
				);
				display: flex;
				flex-direction: column;
				justify-content: flex-end;
				padding: 3em;
				color: white;
			}
			.hero-content h1 {
				color: white;
				font-size: 2.8em;
				margin: 0;
				line-height: 1.1;
				text-shadow: 0 2px 8px rgba(0,0,0,0.7);
			}
			@media (max-width: 720px) {
				.hero-content {
					padding: 2em 1.25em;
				}
				.hero-content h1 {
					font-size: 2em;
				}
			}
			.note-header {
				max-width: 680px;
				margin: 0 auto;
				padding: 2.5em 1em 0;
			}
			.note-header h1 {
				font-size: 2.2em;
				margin: 0 0 0.4em;
			}
			.back-link {
				display: inline-block;
				margin-bottom: 1.5em;
				font-size: 0.9em;
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.back-link:hover {
				color: var(--accent);
			}
			.prose {
				max-width: 680px;
				margin: 0 auto;
				padding: 2em 1em 4em;
			}
			.prose :global(h2) {
				font-size: 1.2em;
				margin: 2em 0 0.6em;
				clear: both;
			}
			.prose :global(p) {
				line-height: 1.75;
				margin: 0 0 1.2em;
				text-align: justify;
				hyphens: auto;
			}
			.prose :global(figcaption) {
				font-size: 0.78em;
				color: rgb(var(--gray));
				font-style: italic;
				margin-top: 0.4em;
				text-align: center;
			}
			.prose :global(.float-right) {
				float: right;
				clear: right;
				width: 280px;
				margin: 0.3em -90px 1.5em 2em;
				border-radius: 4px;
				overflow: hidden;
			}
			.prose :global(.float-left) {
				float: left;
				clear: left;
				width: 280px;
				margin: 0.3em 2em 1.5em -90px;
				border-radius: 4px;
				overflow: hidden;
			}
			.prose :global(.float-right img),
			.prose :global(.float-left img) {
				width: 100%;
				display: block;
			}
			.prose :global(.text-width) {
				display: block;
				width: 100%;
				margin: 1.5em 0;
				clear: both;
			}
			.prose :global(.text-width img) {
				width: 100%;
				display: block;
				border-radius: 4px;
			}
			.prose :global(.audio-block) {
				margin: 1.2em 0;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.4em;
			}
			.prose :global(.audio-block audio) {
				width: 100%;
				max-width: 420px;
			}
			.prose :global(.audio-block figcaption) {
				text-align: center;
			}
			.prose :global(.bibliography) {
				margin-top: 3em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.8em;
				color: rgb(var(--gray));
				line-height: 1.6;
			}
			.prose :global(.bibliography h2) {
				font-size: 0.9em;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: rgb(var(--gray));
				margin: 0 0 0.8em;
			}
			.prose :global(.bibliography p) {
				margin: 0 0 0.7em;
			}
			@media (max-width: 640px) {
				.prose :global(.float-right),
				.prose :global(.float-left) {
					float: none;
					width: 100%;
					margin: 1em 0;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		{heroImage ? (
			<div class="hero">
				<Image class="hero-bg" src={heroImage} alt="" />
				<div class="hero-content">
					<h1>{title}</h1>
				</div>
			</div>
			<div class="prose">
				<a href="/notes" class="back-link">← Notes</a>
				<slot />
			</div>
		) : (
			<div class="note-header">
				<a href="/notes" class="back-link">← Notes</a>
				<h1>{title}</h1>
			</div>
			<div class="prose">
				<slot />
			</div>
		)}
		{gallery.length > 0 && <Gallery slug={slug} images={gallery} basePath="notes" captions={captions} />}
		<Footer />
	</body>
</html>
